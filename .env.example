# Copiá este archivo como `.env` y completá los valores.
# El `.env` real está en .gitignore y nunca se sube al repositorio.

# ---------------------------------------------------------------- Google OAuth
# Salen de console.cloud.google.com → Credenciales → ID de cliente de OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# A dónde vuelve Google después de que el usuario acepta. Tiene que coincidir
# EXACTAMENTE con lo cargado en la consola de Google, carácter por carácter.
#   desarrollo: http://localhost:8791/api/auth/google/callback
#   producción: https://app.botiquant.com/api/auth/google/callback
OAUTH_REDIRECT_URI=http://localhost:8791/api/auth/google/callback

# ------------------------------------------------------------------- sesiones
# Firma las cookies de sesión. Generá uno propio con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Si cambia, todas las sesiones abiertas se invalidan.
SESSION_SECRET=

# --------------------------------------------------------------------- modo
# 1 = instalación compartida: apaga la importación por ruta, el borrado de
# instrumentos del catálogo y la descarga desde Dukascopy.
QF_MULTIUSER=0
